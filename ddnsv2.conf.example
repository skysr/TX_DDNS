# TX_DDNS 配置文件
# 复制此文件为 ddnsv2.conf 并填入实际值

# ============ 必填配置 ============

# DNSPod API Token（ID,Token 格式）
# 获取方式: https://console.dnspod.cn/user/user/api
LOGIN_TOKEN='xxxxxxxx,xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'

# ============ 记录配置 ============
#
# 两种模式二选一：
#
# 【多记录模式】设置 RECORDS_FILE，由记录列表文件定义所有记录
#   RECORDS_FILE='/etc/ddns/records.list'
#
# 【单记录模式】不设 RECORDS_FILE 时，使用下面的 DOMAIN_ID/RECORD_ID/SUB_DOMAIN

# 多记录模式：记录列表文件路径
# 格式: 子域名|域名ID|记录ID|记录类型|网卡|TTL|IP   （详见 records.list.example）
# 设置此项后，下面的 DOMAIN_ID/RECORD_ID/SUB_DOMAIN/RECORD_TYPE 不再生效
RECORDS_FILE=''

# 单记录模式：域名信息
DOMAIN_ID='xxxxxxxxxxx'
RECORD_ID='xxxxxxxxxxxx'
SUB_DOMAIN='xxxxxx'

# 记录类型：AAAA（IPv6）或 A（IPv4）
RECORD_TYPE='AAAA'

# ============ 可选配置 ============

# 网卡名称（用于获取 IP，留空则自动检测）
NETWORK_INTERFACE=''

# 固定 IPv6 地址（全局默认，可选）
# 填写后直接以此地址更新 DNS，不做网卡检测。仅支持 IPv6 地址。
# 多记录模式下每条记录可用记录列表第 7 字段 (IP) 单独覆盖。
# A (IPv4) 记录不支持固定地址，只能用网卡自动检测。
# 典型场景: 运营商下发的公网 IPv6 是静态分配/固定的，或不在脚本自动检测的第一位。
# 注意: 固定后即使网卡当前没有该地址（如重启后 SLAAC 重新协商）也会按此值推送。
IP_ADDRESS=''

# 日志目录
LOG_DIR='/var/log/ddns'

# 锁文件目录
LOCK_DIR='/var/lock'

# 强制更新周期（单位：检查次数，不是分钟数）
# 脚本每执行一次计数 +1，计数达到该值时即使 IP 未变也会强制重推一次。
# 换算：检查次数 = 强制周期(分钟) / 检查间隔(分钟)
# 例：间隔 5 分钟、每 60 分钟强制重推一次 → 12
FORCE_UPDATE_CYCLE=60

# DNS 记录 TTL（秒），最小值取决于 DNSPod 设置
RECORD_TTL=600

# API 重试次数
MAX_RETRY=3

# 重试间隔（秒）
RETRY_DELAY=2

# 更新历史最大记录数
HISTORY_MAX=100

# ============ Webhook 通知 ============
# 支持: 通用 JSON、Discord、Slack、Telegram 等

# Webhook URL（留空则不发送通知）
WEBHOOK_URL=''

# Webhook 方法（POST 或 GET）
WEBHOOK_METHOD='POST'

# Telegram chat_id（也可用 URL 查询串 ?chat_id=xxx 代替）
WEBHOOK_CHAT_ID=''
